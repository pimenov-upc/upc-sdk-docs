":119,"pagefind":7,"draft":11},"Host Codes",[],{"hidden":11,"attrs":120},{},"src/content/docs/en/common/codes/host-codes.mdx","1115b400bb3df053","en/common/codes/transaction-codes",{"id":123,"data":125,"filePath":130,"digest":131,"deferredRender":7},{"title":126,"editUrl":7,"head":127,"template":9,"sidebar":128,"pagefind":7,"draft":11},"Transaction Codes",[],{"hidden":11,"attrs":129},{},"src/content/docs/en/common/codes/transaction-codes.mdx","8ed4ad9280eed0c8","en/common/http-transport/http-transport",{"id":132,"data":134,"filePath":139,"digest":140,"deferredRender":7},{"title":135,"editUrl":7,"head":136,"template":9,"sidebar":137,"pagefind":7,"draft":11},"HttpTransport",[],{"hidden":11,"attrs":138},{},"src/content/docs/en/common/http-transport/http-transport.mdx","0f55c2ec5dad4778","en/common/overview",{"id":141,"data":143,"filePath":148,"digest":149,"deferredRender":7},{"title":144,"editUrl":7,"head":145,"template":9,"sidebar":146,"pagefind":7,"draft":11},"Common constants, structures and classes",[],{"hidden":11,"attrs":147},{},"src/content/docs/en/common/overview.mdx","6cecc0c23ceed05a","en/common/xml-utils/xml-utils",{"id":150,"data":152,"filePath":156,"digest":157,"deferredRender":7},{"title":135,"editUrl":7,"head":153,"template":9,"sidebar":154,"pagefind":7,"draft":11},[],{"hidden":11,"attrs":155},{},"src/content/docs/en/common/xml-utils/xml-utils.mdx","5c327371d1f33863","en/overview",{"id":158,"data":160,"filePath":165,"digest":166,"deferredRender":7},{"title":161,"editUrl":7,"head":162,"template":9,"sidebar":163,"pagefind":7,"draft":11},"Overview",[],{"hidden":11,"attrs":164},{},"src/content/docs/en/overview.mdx","d695d1b166b89097","uk/artifacts/bin-info",{"id":167,"data":169,"filePath":173,"digest":174,"deferredRender":7},{"title":6,"editUrl":7,"head":170,"template":9,"sidebar":171,"pagefind":7,"draft":11},[],{"hidden":11,"attrs":172},{},"src/content/docs/uk/artifacts/bin-info.mdx","2dbc40f8da9a87e1","uk/artifacts/checkout-xml",{"id":175,"data":177,"filePath":181,"digest":182,"deferredRender":7},{"title":18,"editUrl":7,"head":178,"template":9,"sidebar":179,"pagefind":7,"draft":11},[],{"hidden":11,"attrs":180},{},"src/content/docs/uk/artifacts/checkout-xml.mdx","c9b368d766230770","uk/artifacts/refund-xml",{"id":183,"data":185,"filePath":189,"digest":190,"deferredRender":7},{"title":27,"editUrl":7,"head":186,"template":9,"sidebar":187,"pagefind":7,"draft":11},[],{"hidden":11,"attrs":188},{},"src/content/docs/uk/artifacts/refund-xml.mdx","595dc99112332b81","uk/artifacts/sign-service",{"id":191,"data":193,"body":197,"filePath":198,"digest":199,"deferredRender":7},{"title":36,"editUrl":7,"head":194,"template":9,"sidebar":195,"pagefind":7,"draft":11},[],{"hidden":11,"attrs":196},{},"Сервіс `UpcSignService` відповідає за підписання запитів клієнта і валідацію відповідей сервера.\nСервіс представлений класом `UpcSignService`.\n\n## Встановлення\n\nДля встановлення необхідно виконати команду:\n\n```shell\nnpm i @upc/sign-service\n```\n\n:::note\nВсі артефакти сервісів SDK вже мають в собі `UpcSignService` і вміють підписувати запити і верифікувати відповіді.\n:::\n\n## Методи\n\nКлас `UpcSignService` надає статичні методи для підписання запитів і перевірки відповідей.\n\n- `sign()` - підписання JSON запитів\n- `signXml()` - підписання XML запитів\n- `verify()` - перевірка JSON/String відповідей\n- `verifyXml()` - перевірка XML відповідей\n\n## Алгоритми\n\nДля підписання можливо використовувати наступні алгоритми:\n\n- `SHA256` - значення для параметра `RS256` (значення за замовченням)\n- `SHA512` - значення для параметра `RS512`\n\n## JSON (JWS)\n\nДля роботи з даними в форматі `JWS` призначені методи `sign()` та `verify()`.\n\n### Підписання JWS\n\nДля підписання JSON об'єкта і формування JWS необхідно викликати метод `sign(...)` з відповідними параметрами.\n\nСігнатура метода:\n```ts\nsign(\n  payload: string | Buffer,\n  privateKey: string | Buffer,\n  passphrase?: string,\n  algorithm: SigningAlgorithm = 'RS256'\n): SignedPayload {}\n```\n\nПриклад:\n```ts\nconst payload = {\n  merchantId: '1750000',\n  terminalId: 'E1750000',\n}\nconst privateKey = 'path/to/private/key'\nconst passphrase = 'private_key_password'\nconst algorithm = 'RS256'\n\nconst signedPayload = UpcSignService.sign(\n  JSON.stringify(payload), \n  privateKey, \n  passphrase, \n  algorithm\n)\n```\n\nПісля підписання ви отримуєте закодований в `Base64Url` JSON/JWS об'єкт формату:\n\n```json\n{\n  header: {...},\n  payload: {...},\n  signature: {...}\n}\n```\n\nПриклад підписаного запиту:\n\n```json\n{\n    \"header\": \"eyJhbGciOiJSUzI1NiJ9\",\n    \"payload\": \"ewogICAgIk1lcmNoYW50SUQiOiAiMTc1MDAwMCIsCiAgICAiVGVybWluYWxJRCI6ICJFMTc1MDAwMCIsCiAgICAiVHJhY2tpbmdJZCI6ICIyMzQxMzUxMmZ3c2QiLAogICAgImNhcmQiOiB7CiAgICAgICAgIkNhcmROdW0iOiAiNTUwNjkwMDQ4MDEwMDAwNiIsCiAgICAgICAgImV4cE1vbnRoIjogIjA0IiwKICAgICAgICAiZXhwWWVhciI6ICIyMDI0IgogICAgfQp9\",\n    \"signature\": \"Z4Ptjdjbb-4TXjGJak8yU9MTtgV0qU9o7DXfkhecO-768itNl6jRPpg_qrTmBijHvGSB2ULkFbpd1pZTTsiwjojiE5n7JesrjHdxdN5oftTH88LduHKpCJB4ej0pPLJikdhZOrFuppjiKRc0v40_HO4Ip1Q2Dtg5U9jGM-fHzzcx8aGfzHB64gkrYKlujva49X4OR6pXn3HWDPpFDkqzf0mplP5RVRHo7FMV79hz1Z1BuggycvXK72UwiuBe2UdGHXWLOelw-Zqxq80DLgRbrFDNMxn-OhfcQ6FCeDaM8UYusa8ErkXljJ8piiWlsuR2NgZdl-hcarzsmP1IYdiuaA\"\n}\n```\n\nЦей об'єкт готовий до передачі в бік сервісів UPC, які підтримують JWS.\n\n### Верифікація відповіді JWS\n\nЯкщо сервер розпізнав ваш запит (за допомогою завантаженого в UPC вашого публічного ключа або сертифікату), він так само формує навантаження і підписує його.\nДля перевірки того, що ви дійсно отримали відповідь від довіреного сервера, необхідно верифікувати відповідь.\nВерифікація відповіді в форматі JWS здійснюється за допомогою метода `verify()`.\n\nСігнатура метода:\n```ts\nverify(\n  signedPayload: SignedPayload | string, \n  publicKey: string | Buffer\n): boolean {}\n```\n\nПриклад:\n```ts\n// publicKey - шлях до сертифікату або публічного ключа сервера\nconst result = ... // відповідь сервера\nconst verifier = UpcSignService.verify(result, publicKey)\n\nif (!verifier) {\n  throw new Error('Помилка верифікації');\n}\n\n// ... подальші дії з отриманою відповіддю\n```\n\n## XML\n\nДля роботи з даними в форматі `XML` призначені методи `signXml()` та `verifyXml()`.\n\n### Підписання XML\n\nДля підписання Xml об’єкта необхідно викликати метод signXml(...) з відповідними параметрами.\n\nСігнатура метода:\n```ts\nsignXml(\n  xml: string,\n  privateKey: string | Buffer,\n  passphrase?: string,\n  algorithm: SigningAlgorithm = 'RS256'\n): SignedPayload {}\n```\n\nПриклад:\n```ts\nconst xml = ... // raw xml string\nconst signedXml = UpcSignService.signXml(\n  payload, \n  privateKey, \n  passphrase, \n  algorithm\n)\n```\n\nПісля підписання в ваш XML буде додано відповідний тег `\u003CSignature>`.\n\nПриклад підписаного XML\n\n```xml\n\u003CGetBinInfoRequest>\n    \u003CMerchantId>********\u003C/MerchantId>\n    \u003CTerminalId>********\u003C/TerminalId>\n    \u003CTrackingId>********\u003C/TrackingId>\n    \u003CGetBinInfo>\n        \u003CBin>51207000\u003C/Bin>\n    \u003C/GetBinInfo>\n    \u003CSignature>\n        \u003CSignedInfo>\n            \u003CCanonicalizationMethod/>\n            \u003CSignatureMethod/>\n            \u003CReference URI=\"\">\n                \u003CTransforms>\n                    \u003CTransform/>\n                \u003C/Transforms>\n                \u003CDigestMethod Algorithm=\"http://www.w3.org/2000/09/xmldsig#sha256 \"/>\n                \u003CDigestValue>bdJTaGWcCu14aflcgA8bSK+gKdA=\u003C/DigestValue>\n            \u003C/Reference>\n        \u003C/SignedInfo>\n        \u003CSignatureValue>aBOIneD1sIa6AII57BJ5LQqJSP18ix1T7JFQ9zF1noFoX7RicX7tvq9N99OX34h7nHYC3BM8JUv1\n            vghAJx4oXF9/Wlkr+hXCMprC+GCKSaz6z9fQV9DfjedUtZqPDC76mcDnOhLInzBaRWlpxmymGlkR\n            8Ru2DwZaPfxOjrgDAaxZiwnzk/sry4j4q1s0UlPK27q0xodY0JdSk+aAEvHqVYfodnibplYLGJ\n            eQqnhMCRdy4njwHVW15JXRVpfy1UgTm7rBk2LT9R44EnyTv8JXcSfJLareaFramJOtMDE61/TPQ3\n            ubTfnvijyFTtMqYCfMUUhVdLu+4PGLyG+W26iw==\n        \u003C/SignatureValue>\n    \u003C/Signature>\n\u003C/GetBinInfoRequest>\n```\n\n:::note\nВсі необхідні поля в сігнатурі підпису метод `signXml()` додасть самостійно.\n:::\n\nПідписаний XML можна передавати на обробку серверу UPC.\n\n### Перевірка XML відповіді\n\nЩоб перевірити достовірність відповіді (що відповідь прийшла від довіреного серверу), необхідно використати метод `verifyXml()`.\n\nСігнатура метода:\n```ts\nverifyXml(\n  xml: string, \n  publicKey: string | Buffer\n): boolean {}\n```\n\nПриклад:\n```ts\n// publicKey - шлях до сертифікату або публічного ключа сервера\nconst xml = ... // відповідь сервера\nconst verifier = UpcSignService.verifyXml(xml, publicKey)\n\nif (!verifier) {\n  throw new Error('Помилка верифікації');\n}\n\n// ... подальші дії з отриманою відповіддю\n```\n\n## Сертифікат чи публічний ключ\n\nДля перевірки відповіді ви можете використовувати сертифікат довіреного сервера або його публічний ключ.\n\n:::note\nСертифікат можна використовувати за умови, що з нього можна вивести публічний ключ!\n:::","src/content/docs/uk/artifacts/sign-service.mdx","eb73fa5c46870dbc","uk/artifacts/token-service",{"id":200,"data":202,"filePath":206,"digest":207,"deferredRender":7},{"title":45,"editUrl":7,"head":203,"template":9,"sidebar":204,"pagefind":7,"draft":11},[],{"hidden":11,"attrs":205},{},"src/content/docs/uk/artifacts/token-service.mdx","d4b03abb3797d4da","uk/artifacts/token-service-xml",{"id":208,"data":210,"filePath":214,"digest":215,"deferredRender":7},{"title":54,"editUrl":7,"head":211,"template":9,"sidebar":212,"pagefind":7,"draft":11},[],{"hidden":11,"attrs":213},{},"src/content/docs/uk/artifacts/token-service-xml.mdx","6c8fbf6944bbda52","uk/certificates",{"id":216,"data":218,"filePath":222,"digest":223,"deferredRender":7},{"title":63,"editUrl":7,"head":219,"template":9,"sidebar":220,"pagefind":7,"draft":11},[],{"hidden":11,"attrs":221},{},"src/content/docs/uk/certificates.mdx","60de704