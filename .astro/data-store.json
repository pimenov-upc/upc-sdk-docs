n/codes/host-codes",{"id":151,"data":153,"filePath":158,"digest":159,"deferredRender":8},{"title":154,"editUrl":8,"head":155,"template":47,"sidebar":156,"pagefind":8,"draft":31},"Host Codes",[],{"hidden":31,"attrs":157},{},"src/content/docs/en/common/codes/host-codes.mdx","1115b400bb3df053","en/common/codes/transaction-codes",{"id":160,"data":162,"filePath":167,"digest":168,"deferredRender":8},{"title":163,"editUrl":8,"head":164,"template":47,"sidebar":165,"pagefind":8,"draft":31},"Transaction Codes",[],{"hidden":31,"attrs":166},{},"src/content/docs/en/common/codes/transaction-codes.mdx","8ed4ad9280eed0c8","en/common/http-transport/http-transport",{"id":169,"data":171,"filePath":176,"digest":177,"deferredRender":8},{"title":172,"editUrl":8,"head":173,"template":47,"sidebar":174,"pagefind":8,"draft":31},"HttpTransport",[],{"hidden":31,"attrs":175},{},"src/content/docs/en/common/http-transport/http-transport.mdx","0f55c2ec5dad4778","en/common/overview",{"id":178,"data":180,"filePath":185,"digest":186,"deferredRender":8},{"title":181,"editUrl":8,"head":182,"template":47,"sidebar":183,"pagefind":8,"draft":31},"Common constants, structures and classes",[],{"hidden":31,"attrs":184},{},"src/content/docs/en/common/overview.mdx","6cecc0c23ceed05a","en/common/xml-utils/xml-utils",{"id":187,"data":189,"filePath":193,"digest":194,"deferredRender":8},{"title":172,"editUrl":8,"head":190,"template":47,"sidebar":191,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":192},{},"src/content/docs/en/common/xml-utils/xml-utils.mdx","5c327371d1f33863",{"id":19,"data":196,"filePath":201,"digest":202,"deferredRender":8},{"title":197,"editUrl":8,"head":198,"template":47,"sidebar":199,"pagefind":8,"draft":31},"Overview",[],{"hidden":31,"attrs":200},{},"src/content/docs/en/overview.mdx","d695d1b166b89097","uk",{"id":203,"data":205,"body":33,"filePath":217,"assetImports":218,"imageImports":219,"digest":221,"deferredRender":8},{"title":6,"description":7,"editUrl":8,"head":206,"template":10,"hero":207,"sidebar":215,"pagefind":8,"draft":31},[],{"tagline":12,"image":208,"actions":209},{"alt":14,"file":15},[210,213],{"text":18,"link":211,"variant":20,"icon":212},"uk/overview",{"type":22,"name":23},{"text":25,"link":26,"variant":27,"icon":214},{"type":22,"name":29},{"hidden":31,"attrs":216},{},"src/content/docs/uk/index.mdx",[15],[220],[38,39,40],"23cb0c5a63f12b63","uk/artifacts/bin-info",{"id":222,"data":224,"filePath":228,"digest":229,"deferredRender":8},{"title":45,"editUrl":8,"head":225,"template":47,"sidebar":226,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":227},{},"src/content/docs/uk/artifacts/bin-info.mdx","2dbc40f8da9a87e1","uk/artifacts/checkout-xml",{"id":230,"data":232,"filePath":236,"digest":237,"deferredRender":8},{"title":55,"editUrl":8,"head":233,"template":47,"sidebar":234,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":235},{},"src/content/docs/uk/artifacts/checkout-xml.mdx","c9b368d766230770","uk/artifacts/refund-xml",{"id":238,"data":240,"filePath":244,"digest":245,"deferredRender":8},{"title":64,"editUrl":8,"head":241,"template":47,"sidebar":242,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":243},{},"src/content/docs/uk/artifacts/refund-xml.mdx","595dc99112332b81","uk/artifacts/sign-service",{"id":246,"data":248,"body":252,"filePath":253,"digest":254,"deferredRender":8},{"title":73,"editUrl":8,"head":249,"template":47,"sidebar":250,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":251},{},"Сервіс `UpcSignService` відповідає за підписання запитів клієнта і валідацію відповідей сервера.\nСервіс представлений класом `UpcSignService`.\n\n## Встановлення\n\nДля встановлення необхідно виконати команду:\n\n```shell\nnpm i @upc/sign-service\n```\n\n:::note\nВсі артефакти сервісів SDK вже мають в собі `UpcSignService` і вміють підписувати запити і верифікувати відповіді.\n:::\n\n## Методи\n\nКлас `UpcSignService` надає статичні методи для підписання запитів і перевірки відповідей.\n\n- `sign()` - підписання JSON запитів\n- `signXml()` - підписання XML запитів\n- `verify()` - перевірка JSON/String відповідей\n- `verifyXml()` - перевірка XML відповідей\n\n## Алгоритми\n\nДля підписання можливо використовувати наступні алгоритми:\n\n- `SHA256` - значення для параметра `RS256` (значення за замовченням)\n- `SHA512` - значення для параметра `RS512`\n\n## JSON (JWS)\n\nДля роботи з даними в форматі `JWS` призначені методи `sign()` та `verify()`.\n\n### Підписання JWS\n\nДля підписання JSON об'єкта і формування JWS необхідно викликати метод `sign(...)` з відповідними параметрами.\n\n```ts\nconst payload = {\n  merchantId: '1750000',\n  terminalId: 'E1750000',\n}\nconst privateKey = 'path/to/private/key'\nconst passphrase = 'private_key_password'\nconst algorithm = 'RS256'\n\nconst signedPayload = UpcSignService.sign(\n  payload, \n  privateKey, \n  passphrase, \n  algorithm\n)\n```\n\nПісля підписання ви отримуєте закодований в `Base64Url` JSON/JWS об'єкт формату:\n\n```json\n{\n  header: {...},\n  payload: {...},\n  signature: {...}\n}\n```\n\nПриклад підписаного запиту:\n\n```json\n{\n    \"header\": \"eyJhbGciOiJSUzI1NiJ9\",\n    \"payload\": \"ewogICAgIk1lcmNoYW50SUQiOiAiMTc1MDAwMCIsCiAgICAiVGVybWluYWxJRCI6ICJFMTc1MDAwMCIsCiAgICAiVHJhY2tpbmdJZCI6ICIyMzQxMzUxMmZ3c2QiLAogICAgImNhcmQiOiB7CiAgICAgICAgIkNhcmROdW0iOiAiNTUwNjkwMDQ4MDEwMDAwNiIsCiAgICAgICAgImV4cE1vbnRoIjogIjA0IiwKICAgICAgICAiZXhwWWVhciI6ICIyMDI0IgogICAgfQp9\",\n    \"signature\": \"Z4Ptjdjbb-4TXjGJak8yU9MTtgV0qU9o7DXfkhecO-768itNl6jRPpg_qrTmBijHvGSB2ULkFbpd1pZTTsiwjojiE5n7JesrjHdxdN5oftTH88LduHKpCJB4ej0pPLJikdhZOrFuppjiKRc0v40_HO4Ip1Q2Dtg5U9jGM-fHzzcx8aGfzHB64gkrYKlujva49X4OR6pXn3HWDPpFDkqzf0mplP5RVRHo7FMV79hz1Z1BuggycvXK72UwiuBe2UdGHXWLOelw-Zqxq80DLgRbrFDNMxn-OhfcQ6FCeDaM8UYusa8ErkXljJ8piiWlsuR2NgZdl-hcarzsmP1IYdiuaA\"\n}\n```\n\nЦей об'єкт готовий до передачі в бік сервісів UPC, які підтримують JWS.\n\n### Верифікація відповіді JWS\n\nЯкщо сервер розпізнав ваш запит (за допомогою завантаженого в UPC вашого публічного ключа або сертифікату), він так само формує навантаження і підписує його.\nДля перевірки того, що ви дійсно отримали відповідь від довіреного сервера, необхідно верифікувати відповідь.\nВерифікація відповіді в форматі JWS здійснюється за допомогою метода `verify()`.\n\n```ts\n// publicKey - шлях до сертифікату або публічного ключа сервера\nconst result = await UpcService.method() // абстрактний приклад\nconst verifier = UpcSignService.verify(result, publicKey)\n\nif (!verifier) {\n  throw new Error('Помилка верифікації');\n}\n\n// ... подальші дії з отриманою відповіддю\n```\n\n## XML\n\nДля роботи з даними в форматі `XML` призначені методи `signXml()` та `verifyXml()`.\n\n### Підписання XML\n\nДля підписання Xml об’єкта необхідно викликати метод signXml(...) з відповідними параметрами.\n\n```ts\nconst xml = ... // raw xml string\nconst signedXml = UpcSignService.signXml(\n  payload, \n  privateKey, \n  passphrase, \n  algorithm\n)\n```\n\nПісля підписання в ваш XML буде додано відповідний тег `\u003CSignature>`.\n\nПриклад підписаного XML\n\n```xml\n\u003CGetBinInfoRequest>\n    \u003CMerchantId>********\u003C/MerchantId>\n    \u003CTerminalId>********\u003C/TerminalId>\n    \u003CTrackingId>********\u003C/TrackingId>\n    \u003CGetBinInfo>\n        \u003CBin>51207000\u003C/Bin>\n    \u003C/GetBinInfo>\n    \u003CSignature>\n        \u003CSignedInfo>\n            \u003CCanonicalizationMethod/>\n            \u003CSignatureMethod/>\n            \u003CReference URI=\"\">\n                \u003CTransforms>\n                    \u003CTransform/>\n                \u003C/Transforms>\n                \u003CDigestMethod Algorithm=\"http://www.w3.org/2000/09/xmldsig#sha256 \"/>\n                \u003CDigestValue>bdJTaGWcCu14aflcgA8bSK+gKdA=\u003C/DigestValue>\n            \u003C/Reference>\n        \u003C/SignedInfo>\n        \u003CSignatureValue>aBOIneD1sIa6AII57BJ5LQqJSP18ix1T7JFQ9zF1noFoX7RicX7tvq9N99OX34h7nHYC3BM8JUv1\n            vghAJx4oXF9/Wlkr+hXCMprC+GCKSaz6z9fQV9DfjedUtZqPDC76mcDnOhLInzBaRWlpxmymGlkR\n            8Ru2DwZaPfxOjrgDAaxZiwnzk/sry4j4q1s0UlPK27q0xodY0JdSk+aAEvHqVYfodnibplYLGJ\n            eQqnhMCRdy4njwHVW15JXRVpfy1UgTm7rBk2LT9R44EnyTv8JXcSfJLareaFramJOtMDE61/TPQ3\n            ubTfnvijyFTtMqYCfMUUhVdLu+4PGLyG+W26iw==\n        \u003C/SignatureValue>\n    \u003C/Signature>\n\u003C/GetBinInfoRequest>\n```\nВсі необхідні поля в сігнатурі підпису метод `signXml()` додасть самостійно.\n\nПідписаний XML можна передавати на обробку серверу UPC.","src/content/docs/uk/artifacts/sign-service.mdx","6b1f04e11d13fdaa","uk/artifacts/token-service",{"id":255,"data":257,"filePath":261,"digest":262,"deferredRender":8},{"title":82,"editUrl":8,"head":258,"template":47,"sidebar":259,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":260},{},"src/content/docs/uk/artifacts/token-service.mdx","d4b03abb3797d4da","uk/artifacts/token-service-xml",{"id":263,"data":265,"filePath":269,"digest":270,"deferredRender":8},{"title":91,"editUrl":8,"head":266,"template":47,"sidebar":267,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":268},{},"src/content/docs/uk/artifacts/token-service-xml.mdx","6c8fbf6944bbda52","uk/certificates",{"id":271,"data":273,"filePath":277,"digest":278,"deferredRender":8},{"title":100,"editUrl":8,"head":274,"template":47,"sidebar":275,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":276},{},"src/content/docs/uk/certificates.mdx","60de704d05baaa2b","uk/common/base/classes",{"id":279,"data":281,"filePath":285,"digest":286,"deferredRender":8},{"title":109,"editUrl":8,"head":282,"template":47,"sidebar":283,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":284},{},"src/content/docs/uk/common/base/classes.mdx","b55b72dfb99eb003","uk/common/base/constants",{"id":287,"data":289,"filePath":293,"digest":294,"deferredRender":8},{"title":118,"editUrl":8,"head":290,"template":47,"sidebar":291,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":292},{},"src/content/docs/uk/common/base/constants.mdx","4417bc0968be56e0","uk/common/base/errors",{"id":295,"data":297,"filePath":301