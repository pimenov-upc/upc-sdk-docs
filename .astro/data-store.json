[["Map",1,2,366,367,430,431],"docs",["Map",3,4,42,43,52,53,61,62,70,71,79,80,88,89,97,98,106,107,115,116,124,125,133,134,142,143,151,152,160,161,169,170,178,179,187,188,19,195,203,204,222,223,230,231,238,239,246,247,255,256,263,264,271,272,279,280,287,288,295,296,303,304,311,312,319,320,327,328,335,336,343,344,351,352,211,359],"en",{"id":3,"data":5,"body":33,"filePath":34,"assetImports":35,"imageImports":36,"digest":41,"deferredRender":8},{"title":6,"description":7,"editUrl":8,"head":9,"template":10,"hero":11,"sidebar":30,"pagefind":8,"draft":31},"UPC SDK Docs","Documentation for UPC SDK!",true,[],"splash",{"tagline":12,"image":13,"actions":16},"The UPC-SDK is a software development kit designed to facilitate interaction with the UPC E-Commerce API.",{"alt":14,"file":15},"","../../../assets/logo.png",[17,24],{"text":18,"link":19,"variant":20,"icon":21},"Read Docs","en/overview","secondary",{"type":22,"name":23},"icon","open-book",{"text":25,"link":26,"variant":27,"icon":28},"GitHub","https://github.com/pimenov-upc/upc-sdk-docs","minimal",{"type":22,"name":29},"external",{"hidden":31,"attrs":32},false,{},"import { Card, CardGrid } from '@astrojs/starlight/components';\n\n\u003CCardGrid>\n\t\u003CCard title=\"Checkout API\" icon=\"rocket\">\n    Це API призначено для використання тими клієнтами, хто має PCI DSS сертифікат та може збирати та обробляти карткові дані на своїх ресурсах...\n\t\u003C/Card>\n\t\u003CCard title=\"Token Service\" icon=\"seti:typescript\">\n    The UPC e-Commerce Connect payment gateway solution incorporates not only its own tokenization capabilities but also external tokenization services, specifically Visa Token Service (VTS) and Mastercard Digital Enablement Service (MDES)...\n\t\u003C/Card>\n\t\u003CCard title=\"3D Secure\" icon=\"padlock\">\n    3DS is a security protocol that provides an additional layer of protection for online purchases made using credit and debit cards...\n\t\u003C/Card>\n\t\u003CCard title=\"Master Pass\" icon=\"seti:makefile\">\n    Authorization request using MasterPass...\n\t\u003C/Card>\n\t\u003CCard title=\"Apple Pay\" icon=\"apple\">\n    Apple Pay payments using cryptograms...\n  \u003C/Card>\n\t\u003CCard title=\"Google Pay\" icon=\"goodreads\">\n    Google Pay payments using cryptograms...\n  \u003C/Card>\n\u003C/CardGrid>","src/content/docs/en/index.mdx",[15],[37],[38,39,40],"hero","image","file","f501c00f58716791","en/artifacts/bin-info",{"id":42,"data":44,"filePath":50,"digest":51,"deferredRender":8},{"title":45,"editUrl":8,"head":46,"template":47,"sidebar":48,"pagefind":8,"draft":31},"UpcBinInfo",[],"doc",{"hidden":31,"attrs":49},{},"src/content/docs/en/artifacts/bin-info.mdx","a9011f0843049438","en/artifacts/checkout-xml",{"id":52,"data":54,"filePath":59,"digest":60,"deferredRender":8},{"title":55,"editUrl":8,"head":56,"template":47,"sidebar":57,"pagefind":8,"draft":31},"UpcCheckoutXml",[],{"hidden":31,"attrs":58},{},"src/content/docs/en/artifacts/checkout-xml.mdx","1c7249b3fba51cfe","en/artifacts/refund-xml",{"id":61,"data":63,"filePath":68,"digest":69,"deferredRender":8},{"title":64,"editUrl":8,"head":65,"template":47,"sidebar":66,"pagefind":8,"draft":31},"UpcRefundXml",[],{"hidden":31,"attrs":67},{},"src/content/docs/en/artifacts/refund-xml.mdx","42e52ab3c0990c04","en/artifacts/sign-service",{"id":70,"data":72,"filePath":77,"digest":78,"deferredRender":8},{"title":73,"editUrl":8,"head":74,"template":47,"sidebar":75,"pagefind":8,"draft":31},"UpcSignService",[],{"hidden":31,"attrs":76},{},"src/content/docs/en/artifacts/sign-service.mdx","e700e7d332892c74","en/artifacts/token-service",{"id":79,"data":81,"filePath":86,"digest":87,"deferredRender":8},{"title":82,"editUrl":8,"head":83,"template":47,"sidebar":84,"pagefind":8,"draft":31},"UpcTokenService",[],{"hidden":31,"attrs":85},{},"src/content/docs/en/artifacts/token-service.mdx","f7d4bfa379c985d9","en/artifacts/token-service-xml",{"id":88,"data":90,"filePath":95,"digest":96,"deferredRender":8},{"title":91,"editUrl