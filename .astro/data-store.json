en/general/common/structures",{"id":151,"data":153,"filePath":158,"digest":159,"deferredRender":8},{"title":154,"editUrl":8,"head":155,"template":47,"sidebar":156,"pagefind":8,"draft":31},"Common structures and types",[],{"hidden":31,"attrs":157},{},"src/content/docs/en/general/common/structures.mdx","7dc3b341d4457a7c","en/general/common/transaction-codes",{"id":160,"data":162,"filePath":167,"digest":168,"deferredRender":8},{"title":163,"editUrl":8,"head":164,"template":47,"sidebar":165,"pagefind":8,"draft":31},"Transaction Codes",[],{"hidden":31,"attrs":166},{},"src/content/docs/en/general/common/transaction-codes.mdx","dd4060c78e8c7a8a",{"id":19,"data":170,"filePath":175,"digest":176,"deferredRender":8},{"title":171,"editUrl":8,"head":172,"template":47,"sidebar":173,"pagefind":8,"draft":31},"Overview",[],{"hidden":31,"attrs":174},{},"src/content/docs/en/overview.mdx","d695d1b166b89097","uk",{"id":177,"data":179,"body":33,"filePath":191,"assetImports":192,"imageImports":193,"digest":195,"deferredRender":8},{"title":6,"description":7,"editUrl":8,"head":180,"template":10,"hero":181,"sidebar":189,"pagefind":8,"draft":31},[],{"tagline":12,"image":182,"actions":183},{"alt":14,"file":15},[184,187],{"text":18,"link":185,"variant":20,"icon":186},"uk/overview",{"type":22,"name":23},{"text":25,"link":26,"variant":27,"icon":188},{"type":22,"name":29},{"hidden":31,"attrs":190},{},"src/content/docs/uk/index.mdx",[15],[194],[38,39,40],"23cb0c5a63f12b63","uk/artifacts/bin-info",{"id":196,"data":198,"filePath":202,"digest":203,"deferredRender":8},{"title":45,"editUrl":8,"head":199,"template":47,"sidebar":200,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":201},{},"src/content/docs/uk/artifacts/bin-info.mdx","2dbc40f8da9a87e1","uk/artifacts/checkout-xml",{"id":204,"data":206,"filePath":210,"digest":211,"deferredRender":8},{"title":55,"editUrl":8,"head":207,"template":47,"sidebar":208,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":209},{},"src/content/docs/uk/artifacts/checkout-xml.mdx","c9b368d766230770","uk/artifacts/refund-xml",{"id":212,"data":214,"filePath":218,"digest":219,"deferredRender":8},{"title":64,"editUrl":8,"head":215,"template":47,"sidebar":216,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":217},{},"src/content/docs/uk/artifacts/refund-xml.mdx","595dc99112332b81","uk/artifacts/sign-service",{"id":220,"data":222,"body":226,"filePath":227,"digest":228,"deferredRender":8},{"title":73,"editUrl":8,"head":223,"template":47,"sidebar":224,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":225},{},"Сервіс `UpcSignService` відповідає за підписання запитів клієнта і валідацію відповідей сервера.\nСервіс представлений класом `UpcSignService`.\n\n## Встановлення\n\nДля встановлення необхідно виконати команду:\n\n```shell\nnpm i @upc/sign-service\n```\n\n## Методи\n\nКлас `UpcSignService` надає статичні методи для підписання запитів і перевірки відповідей.\n\n- `sign()` - підписання JSON запитів\n- `signXml()` - підписання XML запитів\n- `verify()` - перевірка JSON/String відповідей\n- `verifyXml()` - перевірка XML відповідей\n\n## Алгоритми\n\nДля підписання можливо використовувати наступні алгоритми:\n\n- `SHA256` - значення для параметра `RS256` (значення за замовченням)\n- `SHA512` - значення для параметра `RS512`\n\n## JSON (JWS)\n\nДля роботи з призначені методи `sign()` та `verify()`.\n\n### Підписання JWS\n\nДля підписання JSON об'єкта і формування JWS необхідно викликати метод `sign(...)` з відповідними параметрами.\n\n```ts\nconst payload = {\n  merchantId: '1750000',\n  terminalId: 'E1750000',\n}\nconst privateKey = 'path/to/private/key'\nconst passphrase = 'private_key_password'\nconst algorithm = 'RS256'\n\nconst signedPayload = UpcSignService.sign(\n  payload, \n  privateKey, \n  passphrase, \n  algorithm\n)\n```\n\nПісля підписання ви отримуєте закодований JSON/JWS об'єкт формату:\n\n```json\n{\n  header: {...},\n  payload: {...},\n  signature: {...}\n}\n```\n\nЦей об'єкт готовий до передачі в бік сервісів UPC, які підтримують JWS.","src/content/docs/uk/artifacts/sign-service.mdx","3053ac0217cb4aaa","uk/artifacts/token-service",{"id":229,"data":231,"filePath":235,"digest":236,"deferredRender":8},{"title":82,"editUrl":8,"head":232,"template":47,"sidebar":233,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":234},{},"src/content/docs/uk/artifacts/token-service.mdx","d4b03abb3797d4da","uk/artifacts/token-service-xml",{"id":237,"data":239,"filePath":243,"digest":244,"deferredRender":8},{"title":91,"editUrl":8,"head":240,"template":47,"sidebar":241,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":242},{},"src/content/docs/uk/artifacts/token-service-xml.mdx","6c8fbf6944bbda52","uk/general/common/classes",{"id":245,"data":247,"filePath":251,"digest":252,"deferredRender":8},{"title":100,"editUrl":8,"head":248,"template":47,"sidebar":249,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":250},{},"src/content/docs/uk/general/common/classes.mdx","15b3689e365ffc2f","uk/general/common/constants",{"id":253,"data":255,"filePath":259,"digest":260,"deferredRender":8},{"title":109,"editUrl":8,"head":256,"template":47,"sidebar":257,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":258},{},"src/content/docs/uk/general/common/constaants.mdx","fe42b1214092bbcd","uk/general/common/errors",{"id":261,"data":263,"filePath":267,"digest":268,"deferredRender":8},{"title":118,"editUrl":8,"head":264,"template":47,"sidebar":265,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":266},{},"src/content/docs/uk/general/common/errors.mdx","4298e746e1faacd2","uk/general/common/functions",{"id":269,"data":271,"filePath":275,"digest":276,"deferredRender":8},{"title":127,"editUrl":8,"head":272,"template":47,"sidebar":273,"pagefind":8,"draft":31},[],{"hidden":31,"attrs":274},{},"src/content/docs/uk/general/common/functions.mdx","ad5e219f0eaaa213","uk/general/common/host-codes",{"id":277,"data":279,"filePath":283,"digest":284,"deferredRender":8},{"title":136,"editUrl":8,"head":280,"template":47,"sidebar":281,"pagefind":8,"draft":31},